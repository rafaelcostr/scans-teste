# Copie para .env na raiz do projeto ou exporte no PowerShell antes de `npm start`.
# Windows: duplo clique em INICIAR.bat (carrega este ficheiro automaticamente).
# Nunca commite URLs reais com chaves em repositórios públicos.

# Dados reais: 1/true ou omita — se existir qualquer RPC_EVM conhecido, ativa automaticamente.
USE_REAL_CHAIN_DATA=1

# RPC por rede (slug em minúsculas). Exemplo:
# RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
# RPC_BASE=https://mainnet.base.org
# RPC_POLYGON=
# RPC_BSC=
#
# Vários RPC por rede (fallback automático com ethers FallbackProvider):
# RPC_POLYGON=https://rpc1.example,https://rpc2.example
# RPC_FALLBACK_STALL_MS=750

# Ou JSON com várias redes:
# RPC_URLS_JSON={"arbitrum":"https://...","base":"https://..."}
# Lista por rede (merge com RPC_<REDE>):
# RPC_URLS_JSON={"polygon":["https://a","https://b"]}

# Retries em chamadas JSON-RPC (gas, fee(), quotes curados) quando o nó devolve 429 / rate limit
# RPC_MAX_RETRIES=5
#
# Métricas por endpoint + circuit breaker (por URL na lista; Fallback tenta o seguinte):
# RPC_CIRCUIT_BREAKER=1
# RPC_CB_FAILURE_THRESHOLD=4
# RPC_CB_COOLDOWN_MS=45000
# RPC_CIRCUIT_BREAKER=0 — só contagem/latência, sem cooldown forçado

# Quotes on-chain curados (Quoter): 1 desativa
# DISABLE_CURATED_ONCHAIN_QUOTES=0

# CoinGecko Pro (opcional, melhor rate limit)
# COINGECKO_API_KEY=

# Simulação estimateGas: endereço “from” fictício com saldo na rede (opcional)
# QUOTE_SIM_FROM=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045
#
# Bloco opcional para eth_call / estimateGas (aproximação; depende do nó):
# QUOTE_SIM_BLOCK_TAG=pending
# QUOTE_SIM_BLOCK_TAG=latest
# QUOTE_SIM_BLOCK_TAG=0xabc123…
#
# Agregadores em Polygon (dois USDC): escolha o endereço do stable para 1inch/0x
# AGGREGATOR_POLYGON_STABLE=0x3c499c542cEF5E3811e1192ce70d8cC03e5e3342
# AGGREGATOR_POLYGON_STABLE_DECIMALS=6
#
# Telemetria DexScreener (latência por mercado no /api/config): 0 = desliga
# DEXSCREENER_TELEMETRY=1

# Notional USD e slippage modelo
NOTIONAL_USD=200
SLIPPAGE_BPS=20

# Lucro líquido mínimo (USD) para "compensa" / notificações (default 1). Ruído do modelo DexScreener fica fora.
# MIN_NET_PROFIT_USD=1
# MIN_NET_PROFIT_USD=0

# Spread bruto mínimo (%) para marcar worthwhile (0 = desligado). Útil para filtrar ruído de spread ínfimo.
# MIN_SPREAD_PERCENT=0.02

# Aviso “stale” na UI e confiança: idade máxima (segundos) desde quoteFetchedAt do DexScreener.
# QUOTE_MAX_AGE_SEC=120

# Mercados dinâmicos: liquidez mínima = max(DYNAMIC_MIN_LIQ_USD, NOTIONAL_USD * mult) se mult > 0.
# DYNAMIC_MIN_LIQ_USD=2500
# DYNAMIC_LIQ_NOTIONAL_MULT=1.25

# --- Webhook (POST JSON quando existir ≥1 mercado worthwhile no fim de GET /api/scan) ---
# WEBHOOK_URL=https://example.com/hook
# WEBHOOK_SECRET= — se definido: header X-Webhook-Signature: sha256=<HMAC do corpo UTF-8> e X-Webhook-Secret (legado)
# WEBHOOK_COOLDOWN_MS=90000
# WEBHOOK_MAX_RETRIES=5 — tentativas extra após a 1.ª (backoff em 429/5xx/erro de rede)
# WEBHOOK_RETRY_BACKOFF_MS=500
# WEBHOOK_TIMEOUT_MS=12000
# WEBHOOK_MINIMAL_PAYLOAD=1 — omite a lista intents; inclui links (use WEBHOOK_PUBLIC_BASE_URL para URLs absolutas)
# WEBHOOK_PUBLIC_BASE_URL=https://o-teu-servidor.example.com
# ENABLE_WEBHOOK=0
# WEBHOOK_DEDUPE_FINGERPRINT=1 — não reenviar o mesmo conjunto de mercados worthwhile dentro da janela
# WEBHOOK_DEDUPE_WINDOW_MS=120000

# --- Executor (fila in-memory; validação + dry-run — não envia transações on-chain) ---
# EXECUTOR_API_KEY= — obrigatório para ativar POST /api/executor/enqueue e /tick (header X-Executor-Key)
# EXECUTOR_BASE_URL=http://127.0.0.1:3000
# EXECUTOR_QUEUE_MAX=100
# EXECUTOR_QUEUE_RETAIN=200
# EXECUTOR_KILL_SWITCH=1
# EXECUTOR_MAX_PROFIT_DRIFT_USD=0.08
#
# npm run executor:tick — chama um tick (requer servidor + scan em cache).
# npm run executor:simulate -- --chain=base — simula execução (paper, sem tx nem saldo na carteira).

# --- Filtros só para GET /api/intents e campo intents no webhook (não altera worthwhile do scan) ---
# INTENTS_ONCHAIN_ONLY=1
# INTENTS_CHAINS=arbitrum,base
# INTENTS_MIN_NET_USD=5

# Cache HTTP DexScreener (ms) e retries
HTTP_CACHE_TTL_MS=20000
DEXSCREENER_CACHE_MS=15000
HTTP_MAX_RETRIES=4

# Concorrência DexScreener **por mercado** (pools do mesmo mercado em paralelo)
DEXSCREENER_CONCURRENCY=4

# Fila global FIFO para **todos** os GET api.dexscreener.com (scanner + dinâmicos + liquidez curated).
# 1 = um pedido de cada vez na rede (ordem global); 2+ permite N pedidos Dex em paralelo mantendo fila.
# DEXSCREENER_GLOBAL_CONCURRENCY=1

SCAN_PARALLEL=6

# Mercados dinâmicos (seeds)
# DISABLE_DYNAMIC=0
# MAX_DYNAMIC_MARKETS=200
#
# Filtros extra nos pares DexScreener antes de formar mercado dinâmico (≥2 DEX):
# DYNAMIC_MIN_H24_VOLUME_USD=50000
# DYNAMIC_MAX_VOL_TO_LIQ_RATIO=80
# DYNAMIC_MIN_PAIR_AGE_HOURS=24
# DYNAMIC_DEX_ALLOWLIST=uniswap,sushiswap
# DYNAMIC_DEX_BLOCKLIST=
# DYNAMIC_SYMBOL_HEURISTICS=0

# Porta do painel
# PORT=3000
# SCAN_UI_POLL_MS=15000

# --- Agregadores (1inch / 0x) como fallback quando o Quoter curado falha (arbitrum, base, bsc) ---
# ENABLE_AGGREGATORS=1
# ONEINCH_API_KEY=
# ZEROX_API_KEY=

# --- Jupiter Solana (USDC↔SOL round-trip, só leitura) ---
# ENABLE_JUPITER_SOL=1
# JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote

# --- Histórico de scans (JSONL no servidor) ---
# ENABLE_SCAN_HISTORY=1
# ENABLE_SCAN_HISTORY=0
# HISTORY_MAX_SCANS=200
# HISTORY_FILE=
#
# Heurística de ruído (últimos scans no JSONL): aviso em mercados com muitos worthwhile só no modelo e poucos/nenhum on-chain.
# HISTORY_NOISE_WINDOW_SCANS=30
# HISTORY_NOISE_MODEL_MIN=4
# HISTORY_NOISE_ONLY_DYNAMIC=1
# HISTORY_NOISE_ONLY_DYNAMIC=0
#
# Volatilidade do spread no histórico (avisos extra em historyHints):
# HISTORY_VOLATILITY_WINDOW_SCANS=30
# HISTORY_VOLATILITY_MIN_POINTS=5
# HISTORY_VOLATILITY_STDDEV_SPREAD_MIN=0.12
# HISTORY_VOLATILITY_RANGE_SPREAD_MIN=0.35
# HISTORY_VOLATILITY_ONLY_DYNAMIC=1
# HISTORY_VOLATILITY_ONLY_DYNAMIC=0
#
# Export no painel: GET /api/scan/export?format=csv&useLast=1 (reutiliza o último
# /api/scan em memória; sem cache corre um scan novo).
#
# Teste webhook local: num terminal `npm run webhook:echo`; noutro defina
# WEBHOOK_URL=http://127.0.0.1:3333/webhook e WEBHOOK_SECRET igual a WEBHOOK_RECEIVER_SECRET.

# --- Risk gate do executor dry-run (preparacao para bot profissional) ---
# RISK_POLICY_DISABLED=0
# RISK_REQUIRE_ONCHAIN=1
# RISK_ALLOW_DYNAMIC=0
# RISK_ALLOWED_CHAINS=base,arbitrum,polygon
# RISK_MAX_NOTIONAL_USD=250
# RISK_MIN_NET_PROFIT_USD=2
# RISK_MIN_PROFIT_BUFFER_USD=0.25
# RISK_MAX_SLIPPAGE_BPS=50
# RISK_MAX_QUOTE_AGE_SEC=20

# --- Loop de paper trading por dias (servidor precisa estar ligado) ---
# PAPER_LOOP_INTERVAL_MS=15000
# PAPER_START_BALANCE_USD=200
# PAPER_TRADES_FILE=data/paper-trades.jsonl
# PAPER_LOOP_STATUS_FILE=data/paper-loop-status.json
# PAPER_LOG_DISABLED=0
